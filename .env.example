# -----------------------------------------------------------------------------
# TANTRA GROUP OF INDUSTRIES (TGOI) — Environment Configuration Example
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` (or `.env`) and replace every value with a
# REAL, secure value. NEVER commit real secrets to the repository — the
# `.gitignore` rules ignore `.env` and `.env.*` files.
#
# Run `npm run dev` only after you have configured the values below.

# -----------------------------------------------------------------------------
# CORPORATE ACCESS (Phase 3 secure authentication)
# -----------------------------------------------------------------------------

# Gate code that corporate members must present before login is processed.
# Provide a long, random, high-entropy value. Never commit the real value.
CORPORATE_ACCESS_CODE=replace_with_secure_value

# Random secret used for session security. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_secure_random_secret

# -----------------------------------------------------------------------------
# DATABASE (Phase 4+ — Corporate management system data layer)
# -----------------------------------------------------------------------------

# Production database connection string. Not required for Phase 3; the auth
# system fails safely (login is rejected) until a real database is configured.
DATABASE_URL=replace_with_database_url